{
	"nodes":[
		{"id":"79a9d1e438fd44af","x":-1859,"y":-817,"width":255,"height":73,"type":"text","text":"porém, o autor desconstrói essa ideia "},
		{"id":"f316a690865d3d45","x":-1883,"y":-701,"width":250,"height":80,"type":"text","text":"demonstra influência das teorias raciais"},
		{"id":"4e59543beb51130f","x":-1888,"y":-575,"width":284,"height":91,"type":"text","text":"Mesmo discutindo raça e identidade nacional"},
		{"id":"4d9d6324fd77484c","x":-1893,"y":-444,"width":269,"height":60,"type":"text","text":"negros aparecem como"},
		{"id":"d60a0a6cf8213414","x":-1829,"y":-932,"width":289,"height":50,"type":"text","text":"Se passa no espirito santo"},
		{"id":"9f32de416a452a14","x":-2185,"y":-844,"width":250,"height":80,"type":"text","text":"significado do título da obra"},
		{"id":"804fa6527fef36e6","x":-2143,"y":-957,"width":250,"height":75,"type":"text","text":"o cenários representa o pré-modernismo"},
		{"id":"acc17583713e671c","x":-2240,"y":-720,"width":305,"height":99,"type":"text","text":"nacionalismo extremista e o determinismo racial."},
		{"id":"e84fd2193c5fa73d","x":-2212,"y":-564,"width":250,"height":60,"type":"text","text":" confronto de ideias."},
		{"id":"9d1f590be21dc9cb","x":-2222,"y":-446,"width":250,"height":60,"type":"text","text":"falar de maria"},
		{"id":"8e7335ce87dca3c2","x":-2193,"y":-324,"width":267,"height":50,"type":"text","text":"milkau foge com maria"},
		{"id":"f84e77edd9282906","x":-1466,"y":-944,"width":250,"height":80,"type":"text","text":"considerada a principal obra"},
		{"id":"65d9fab0fc241ef4","x":-1538,"y":-819,"width":250,"height":75,"type":"text","text":"O romance começa com milkau"},
		{"id":"b82d82a1525b315e","x":-1556,"y":-681,"width":250,"height":60,"type":"text","text":"humanista e idealista"},
		{"id":"d0b0089ca83da46e","x":-1513,"y":-557,"width":250,"height":73,"type":"text","text":" imigrantes europeus ocupam"},
		{"id":"a36bfb1e68080335","x":-1552,"y":-444,"width":278,"height":80,"type":"text","text":"mesmo autores considerados modernos"},
		{"id":"8cbd8dcc469e7dce","x":-736,"y":-1057,"width":173,"height":63,"type":"text","text":"época vivida"},
		{"id":"6fd5d5a134810e3f","x":-511,"y":-1055,"width":200,"height":60,"type":"text","text":"Onde se formou"},
		{"id":"cca6f2188cede1bf","x":-311,"y":-950,"width":250,"height":114,"type":"text","text":"Faculdade conhecida pela circulação de ideias filosóficas"},
		{"id":"c84bdcf1e05b2398","x":-672,"y":-936,"width":300,"height":86,"type":"text","text":"Desde jovem, demonstrava posicionamento"},
		{"id":"a8eecfc19d6acbbf","x":-636,"y":-795,"width":250,"height":79,"type":"text","text":"Além da carreira literária"},
		{"id":"34fe51e264119e48","x":-311,"y":-758,"width":250,"height":84,"type":"text","text":"Esse contato influenciou sua visão "},
		{"id":"4155c58c9b8d581c","x":-672,"y":-688,"width":248,"height":118,"type":"text","text":"Nesse período, o país estava passando por grandes mudanças"},
		{"id":"d6ca8b18d5360b17","x":-372,"y":-636,"width":250,"height":60,"type":"text","text":"14 após a abolição"},
		{"id":"d5182180d2516b3a","x":-470,"y":-525,"width":284,"height":90,"type":"text","text":"As teorias raciais e o determinismo científico "},
		{"id":"ad8530b05ef68a5e","x":-986,"y":-1057,"width":181,"height":63,"type":"text","text":"Graça Aranha"},
		{"id":"09194d83326d2e4c","x":-986,"y":-929,"width":250,"height":72,"type":"text","text":"Posteriormente, trabalhou como juiz"},
		{"id":"9544c17bc84efdcd","x":-986,"y":-796,"width":250,"height":80,"type":"text","text":"Encontrou colônias de imigrantes"},
		{"id":"7fad23eb100388fa","x":-1005,"y":-666,"width":269,"height":90,"type":"text","text":"O governo incentivava a imigração"},
		{"id":"51a2fb27bb215a7e","x":-1080,"y":-373,"width":250,"height":80,"type":"text","text":"Justamente nesse cenário que canaã"},
		{"id":"6481531882a89255","x":-1020,"y":-536,"width":284,"height":80,"type":"text","text":"Muitos acreditavam que a chegada de europeus"}
	],
