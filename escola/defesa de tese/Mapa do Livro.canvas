{
	"nodes":[
		{"id":"6c2c0060edfe5d3b","x":-200,"y":-300,"width":277,"height":50,"type":"text","text":"Resumo breve de canaã"},
		{"id":"b8994cedbce6f13d","x":181,"y":-300,"width":307,"height":60,"type":"text","text":"expectativas dos Europeus"},
		{"id":"d233d915e4366283","x":210,"y":-190,"width":250,"height":60,"type":"text","text":"Ao longo da narrativa"},
		{"id":"d71d2ca306e720fe","x":212,"y":-59,"width":250,"height":99,"type":"text","text":"A narrativa começa com mailkau"},
		{"id":"43b81e82e9a491fe","x":181,"y":120,"width":250,"height":79,"type":"text","text":"milkau representa uma visão humanista"},
		{"id":"3d90c091e3860e08","x":-38,"y":240,"width":250,"height":83,"type":"text","text":"apresenta teorias raciais da época"},
		{"id":"f6b6e903f318e8c1","x":-186,"y":40,"width":250,"height":60,"type":"text","text":"significado de canaã"},
		{"id":"2496a4b25f0316dc","x":-172,"y":-130,"width":221,"height":60,"type":"text","text":"cenário escolhido"},
		{"id":"02d21044568ee633","x":-380,"y":222,"width":250,"height":60,"type":"text","text":"uma fusão de raças"},
		{"id":"3b08ce891b2a274a","x":-505,"y":75,"width":250,"height":91,"type":"text","text":"Lentz representa o nacionalismo"},
		{"id":"f314865a70531947","x":-519,"y":-70,"width":279,"height":88,"type":"text","text":"acredita a superioridade Europeia"},
		{"id":"111e42e24cc05f41","x":-600,"y":-232,"width":300,"height":85,"type":"text","text":"o conflito do romance não ocorre nas ações"},
		{"id":"6ba5770a4bd6b9a6","x":-550,"y":-380,"width":190,"height":80,"type":"text","text":"confronto de milkau e lentz"},
		{"id":"a3a404c211c8881f","x":-288,"y":-460,"width":250,"height":80,"type":"text","text":"Apresenta uma forte crítica social"},
		{"id":"1289dd44921a9242","x":56,"y":-457,"width":250,"height":75,"type":"text","text":"aparecem antigos escravizados "},
		{"id":"282c9a3992c37c3e","x":240,"y":-620,"width":296,"height":118,"type":"text","text":"Esse choque de idealização e realidade é mais forte com Maria"},
		{"id":"7176dc1abe2020a6","x":-163,"y":-620,"width":318,"height":118,"type":"text","text":"Mais tarde ela é perseguida e acusada injustamente de infaticidio "},
		{"id":"f7c44265d51e12e6","x":-580,"y":-550,"width":250,"height":90,"type":"text","text":"Tornando-se símbolo da exclusão"},
		{"id":"fa79a6dfa67ead39","x":-610,"y":-650,"width":250,"height":60,"type":"text","text":"milkau conhece maria "},
		{"id":"db97b80d4056cab9","x":-288,"y":-760,"width":415,"height":80,"type":"text","text":"Essas características aproximam Canaã do Pré-Modernismo brasileiro"}
	],
